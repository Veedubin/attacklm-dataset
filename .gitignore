# Upstream source data (cloned by `attacklm-dataset init`; the upstream
# git repo is the source of truth, no point in re-tracking the clone)
# These dirs contain raw upstream data (Metasploit, Sigma, Atomic Red
# Team, etc.) which the extractors transform into per-source JSONL
# training pairs under data/datasets/buckets/sources/<source>/.
data/CTF-Dojo/
data/NYU_CTF_Bench/
data/RTA/
data/access/
data/ai_tools/
data/arsenal/
data/atomic-red-team/
data/elastic-detection-rules/
data/infection_monkey/
data/manx/
data/metasploit-framework/
data/mordor/
data/sigma/
data/splunk-security-content/
data/stockpile/
data/threathunter-playbook/
data/caldera/

# Audit outputs (generated by `attacklm-dataset/scripts/inversion_audit.py`)
# The canonical audit is the latest one per date; older ones can be regenerated
# from the inversion_results.jsonl files.
data/audit/

# Restricted sources (denylisted; live only in archive/restricted-sources/
# which is separately gitignored)
archive/restricted-sources/